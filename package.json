{
  "name": "@dnmitev/inio-mcp",
  "version": "0.1.2-rc.1",
  "description": "Model Context Protocol (MCP) server for the Inio REST API: read customers, invoices, pauses and retry attempts from any AI assistant",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inio",
    "invoices",
    "claude"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnmitev/iniomcp.git"
  },
  "homepage": "https://github.com/dnmitev/iniomcp#readme",
  "bugs": {
    "url": "https://github.com/dnmitev/iniomcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "inio-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.ts",
    "lint": "oxlint --type-aware --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test/unit",
    "test:integration": "npm run build && vitest run --dir test/integration",
    "mutation": "stryker run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:live": "npm run build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --dir test/live",
    "test:package": "vitest run --dir test/package"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@stryker-mutator/core": "^10",
    "@stryker-mutator/vitest-runner": "^10",
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3",
    "testcontainers": "^12.2.1",
    "typescript": "^7",
    "vitest": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
