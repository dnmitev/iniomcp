{
  "name": "inio-mcp-deck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "playwright test",
    "video:studio": "remotion studio video/index.ts --public-dir=audio",
    "video:render": "node scripts/check-audio.cjs && remotion render video/index.ts DeckVideo out/inio-mcp-deck.mp4 --public-dir=audio"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@remotion/bundler": "^4.0.250",
    "@remotion/cli": "^4.0.250",
    "@remotion/media-parser": "^4.0.250",
    "@remotion/media-utils": "^4.0.250",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "remotion": "^4.0.250",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^5.0.5"
  }
}
